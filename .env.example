MAKOSH_HOST=0.0.0.0
MAKOSH_PORT=8787
MAKOSH_TOKEN=change-me-now
MAKOSH_DEVICE_NAME=PC

# Мозг: openrouter | openai | xai | deepseek | local | browser
# Agent не знает вендора — меняется только провайдер.
MAKOSH_LLM_PROVIDER=openrouter
OPENAI_API_KEY=
# Если пусто — URL берётся из MAKOSH_LLM_PROVIDER.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
VISION_MODEL=openai/gpt-4o-mini

# Один запасной ход после 429/5xx, без бесконечных retry.
# MAKOSH_LLM_FALLBACK=openai
# MAKOSH_LLM_FALLBACK_API_KEY=
# MAKOSH_LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# MAKOSH_LLM_FALLBACK_MODEL=gpt-4o-mini
MAKOSH_LLM_RATE_LIMIT_COOLDOWN=60

# Для browser (ещё не автоматизация UI): grok | chatgpt | deepseek
# MAKOSH_BROWSER_LLM_PROVIDER=grok

# Сколько раз в час можно слать скрин в облако. OCR локальный — бесплатный.
VISION_MAX_PER_HOUR=6
VISION_MAX_WIDTH=768

# Локальный TTS. silero = нейросеть v5.5 RU (скачивается один раз), sapi = Windows.
MAKOSH_TTS_ENABLED=true
MAKOSH_TTS_ENGINE=silero
MAKOSH_TTS_VOICE=kseniya
MAKOSH_TTS_DEVICE=cpu
MAKOSH_TTS_RATE=0
MAKOSH_TTS_VOLUME=100
MAKOSH_TTS_PITCH=0
